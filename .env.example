# Copy this file to .env and fill in your Spotify app credentials.
# Get these from https://developer.spotify.com/dashboard (create an app).

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must EXACTLY match a Redirect URI registered in your Spotify app settings,
# e.g. http://127.0.0.1:3000/callback for local dev.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Public base URL used to build shareable join links / QR codes,
# e.g. https://cantina-dj.up.railway.app (no trailing slash).
BASE_URL=http://127.0.0.1:3000

PORT=3000

# Random string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
